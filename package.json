{
  "name": "deep-claw",
  "version": "0.1.0",
  "private": true,
  "description": "DEEP CLAW - portrait mobile arcade game (Phaser 3 + TypeScript + Vite)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
