    "assets:magnet-art": "node tools/make-magnet-art.mjs"
  },
  "devDependencies": {
    "@fontsource/lilita-one": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "typescript": "5.9",
    "vite": "^8.3.5",
